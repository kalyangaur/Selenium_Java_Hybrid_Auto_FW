# Keep the Selenium Hub and browser-node image versions identical.
SELENIUM_VERSION=4.52.0

# Browser selected by your framework: chrome | firefox | edge
BROWSER=chrome
HEADLESS=true

# One session per node is a safe starting point for local Docker resources.
CHROME_MAX_SESSIONS=1
FIREFOX_MAX_SESSIONS=1
EDGE_MAX_SESSIONS=1

# Default Maven command. Change if your TestNG suite is configured differently.
MAVEN_ARGS=clean test
